## Disorder codec for Godot 4.
##
## Encodes and decodes classes generated by `disorder -l gdscript`, in the
## disorder binary format and in JSON. Both are compatible with the Go package.
##
## Failures never throw: encode/decode return an empty array / null (to_json
## returns "") and set Disorder.last_error. Type mismatches are errors.
##
## Usage:
##   var bytes := Disorder.encode(object)
##   var copy = Disorder.decode(bytes, MySchema.MyMessage)
##   var json := Disorder.to_json(object)
##   var copy2 = Disorder.from_json(json, MySchema.MyMessage)
class_name Disorder
extends RefCounted

const TAG_BOOL := 1
const TAG_INT := 2
const TAG_LONG := 3
const TAG_FLOAT := 4
const TAG_DOUBLE := 5
const TAG_BYTES := 6
const TAG_STRING := 11
const TAG_TIMESTAMP := 12
const TAG_ENUM := 13
const TAG_ARRAY_START := 21
const TAG_ARRAY_END := 22
const TAG_OBJECT_START := 23
const TAG_OBJECT_END := 24

## Message of the last failed call, empty after a successful one.
static var last_error := ""


# ---------------------------------------------------------------- binary

## Returns the binary encoding of a generated message, or an empty array on error.
static func encode(object: Object) -> PackedByteArray:
	last_error = ""
	var buf := StreamPeerBuffer.new()
	buf.big_endian = true
	if object == null:
		last_error = "null value cannot be encoded"
	elif _write(buf, ["object", object.get_script()], "", object):
		return buf.data_array
	return PackedByteArray()


## Decodes data into a new instance of cls, a generated message class.
## Returns null on error. Unknown fields are skipped.
static func decode(data: PackedByteArray, cls: GDScript) -> Object:
	last_error = ""
	var buf := StreamPeerBuffer.new()
	buf.big_endian = true
	buf.data_array = data
	if not _need(buf, 1):
		return null
	var value = _read(buf, ["object", cls], buf.get_u8())
	if last_error != "":
		return null
	return value


static func _fail(message: String) -> bool:
	last_error = message
	return false


# Writes tag + optional name + payload. Returns false and sets last_error on failure.
static func _write(buf: StreamPeerBuffer, desc: Variant, name: String, value: Variant) -> bool:
	var kind: String = desc if desc is String else desc[0]
	match kind:
		"bool":
			if not _header(buf, TAG_BOOL, name):
				return false
			buf.put_u8(1 if value else 0)
		"int":
			if not _header(buf, TAG_INT, name):
				return false
			buf.put_32(value)
		"long":
			if not _header(buf, TAG_LONG, name):
				return false
			buf.put_64(value)
		"float":
			if not _header(buf, TAG_FLOAT, name):
				return false
			buf.put_float(value)
		"double":
			if not _header(buf, TAG_DOUBLE, name):
				return false
			buf.put_double(value)
		"timestamp":
			if not _header(buf, TAG_TIMESTAMP, name):
				return false
			buf.put_64(value)
		"string":
			if not _header(buf, TAG_STRING, name):
				return false
			var bytes: PackedByteArray = (value as String).to_utf8_buffer()
			buf.put_u32(bytes.size())
			buf.put_data(bytes)
		"bytes":
			if not _header(buf, TAG_BYTES, name):
				return false
			buf.put_u32(value.size())
			buf.put_data(value)
		"enum":
			var values: Array = desc[1]
			if value < 0 or value >= values.size():
				return _fail("invalid enum value %d" % value)
			if not _header(buf, TAG_ENUM, name):
				return false
			var bytes: PackedByteArray = (values[value] as String).to_utf8_buffer()
			buf.put_u8(bytes.size())
			buf.put_data(bytes)
		"array":
			if not _header(buf, TAG_ARRAY_START, name):
				return false
			for element in value:
				if element == null:
					return _fail("null array element")
				if not _write(buf, desc[1], "", element):
					return false
			buf.put_u8(TAG_ARRAY_END)
			return true
		"map":
			if not _header(buf, TAG_OBJECT_START, name):
				return false
			var keys: Array = value.keys()
			keys.sort()
			for key in keys:
				if not key is String or key == "":
					return _fail("map keys must be non-empty strings")
				if value[key] == null:
					return _fail("null map value for key \"%s\"" % key)
				if not _write(buf, desc[1], key, value[key]):
					return false
			buf.put_u8(TAG_OBJECT_END)
			return true
		"object":
			if not _header(buf, TAG_OBJECT_START, name):
				return false
			for field in value.call("_disorder_fields"):
				var field_value = value.get(field[0])
				if field_value == null:
					continue # nil objects are omitted
				if not _write(buf, field[1], field[0], field_value):
					return false
			buf.put_u8(TAG_OBJECT_END)
			return true
		_:
			return _fail("unknown type descriptor %s" % str(desc))
	return true


static func _header(buf: StreamPeerBuffer, tag: int, name: String) -> bool:
	buf.put_u8(tag)
	if name == "":
		return true
	var bytes := name.to_utf8_buffer()
	if bytes.size() > 255:
		return _fail("name \"%s\" is longer than 255 bytes" % name)
	buf.put_u8(bytes.size())
	buf.put_data(bytes)
	return true


# Reads the payload of a value whose tag was already read. On failure it sets
# last_error and the returned value must be ignored.
static func _read(buf: StreamPeerBuffer, desc: Variant, tag: int) -> Variant:
	var kind: String = desc if desc is String else desc[0]
	match kind:
		"bool":
			return buf.get_u8() == 1 if _expect(tag, TAG_BOOL, kind) and _need(buf, 1) else null
		"int":
			return buf.get_32() if _expect(tag, TAG_INT, kind) and _need(buf, 4) else null
		"long":
			return buf.get_64() if _expect(tag, TAG_LONG, kind) and _need(buf, 8) else null
		"float":
			return buf.get_float() if _expect(tag, TAG_FLOAT, kind) and _need(buf, 4) else null
		"double":
			return buf.get_double() if _expect(tag, TAG_DOUBLE, kind) and _need(buf, 8) else null
		"timestamp":
			return buf.get_64() if _expect(tag, TAG_TIMESTAMP, kind) and _need(buf, 8) else null
		"string":
			if tag != TAG_STRING and tag != TAG_ENUM:
				_expect(tag, TAG_STRING, kind)
				return null
			return _read_string(buf, tag == TAG_ENUM)
		"bytes":
			if not _expect(tag, TAG_BYTES, kind) or not _need(buf, 4):
				return null
			var length := buf.get_u32()
			if not _need(buf, length):
				return null
			return buf.get_data(length)[1]
		"enum":
			if tag != TAG_STRING and tag != TAG_ENUM:
				_expect(tag, TAG_ENUM, kind)
				return null
			var name = _read_string(buf, tag == TAG_ENUM)
			if last_error != "":
				return null
			var index: int = (desc[1] as Array).find(name)
			if index < 0:
				_fail("invalid enum value \"%s\"" % name)
				return null
			return index
		"array":
			if not _expect(tag, TAG_ARRAY_START, kind):
				return null
			var elements := []
			while true:
				if not _need(buf, 1):
					return null
				var element_tag := buf.get_u8()
				if element_tag == TAG_ARRAY_END:
					return elements
				var element = _read(buf, desc[1], element_tag)
				if last_error != "":
					return null
				elements.append(element)
		"map":
			if not _expect(tag, TAG_OBJECT_START, kind):
				return null
			var map := {}
			while true:
				if not _need(buf, 1):
					return null
				var entry_tag := buf.get_u8()
				if entry_tag == TAG_OBJECT_END:
					return map
				var key = _read_string(buf, true)
				if last_error != "":
					return null
				var entry = _read(buf, desc[1], entry_tag)
				if last_error != "":
					return null
				map[key] = entry
		"object":
			if not _expect(tag, TAG_OBJECT_START, kind):
				return null
			return _read_object(buf, desc[1])
	_fail("unknown type descriptor %s" % str(desc))
	return null


static func _read_object(buf: StreamPeerBuffer, cls: GDScript) -> Object:
	var object: Object = cls.new()
	var fields := {}
	for field in object.call("_disorder_fields"):
		fields[field[0]] = field[1]
	while true:
		if not _need(buf, 1):
			return null
		var tag := buf.get_u8()
		if tag == TAG_OBJECT_END:
			return object
		var name = _read_string(buf, true)
		if last_error != "":
			return null
		if not fields.has(name):
			if not _skip(buf, tag):
				return null
			continue
		var value = _read(buf, fields[name], tag)
		if last_error != "":
			return null
		_assign(object, name, fields[name], value)
	return null


# Typed arrays can only be filled in place.
static func _assign(object: Object, name: String, desc: Variant, value: Variant) -> void:
	if desc is Array and desc[0] == "array" and object.get(name) is Array:
		var target: Array = object.get(name)
		target.assign(value)
	else:
		object.set(name, value)


# Reads a string: 1 byte length for names and enums, 4 bytes for strings.
static func _read_string(buf: StreamPeerBuffer, short: bool) -> String:
	var width := 1 if short else 4
	if not _need(buf, width):
		return ""
	var length := buf.get_u8() if short else buf.get_u32()
	if short and length == 0:
		_fail("empty name")
		return ""
	if not _need(buf, length):
		return ""
	return buf.get_data(length)[1].get_string_from_utf8()


static func _skip(buf: StreamPeerBuffer, tag: int) -> bool:
	match tag:
		TAG_BOOL:
			return _skip_bytes(buf, 1)
		TAG_INT, TAG_FLOAT:
			return _skip_bytes(buf, 4)
		TAG_LONG, TAG_DOUBLE, TAG_TIMESTAMP:
			return _skip_bytes(buf, 8)
		TAG_STRING, TAG_BYTES:
			if not _need(buf, 4):
				return false
			return _skip_bytes(buf, buf.get_u32())
		TAG_ENUM:
			if not _need(buf, 1):
				return false
			return _skip_bytes(buf, buf.get_u8())
		TAG_ARRAY_START:
			while true:
				if not _need(buf, 1):
					return false
				var element_tag := buf.get_u8()
				if element_tag == TAG_ARRAY_END:
					return true
				if not _skip(buf, element_tag):
					return false
		TAG_OBJECT_START:
			while true:
				if not _need(buf, 1):
					return false
				var entry_tag := buf.get_u8()
				if entry_tag == TAG_OBJECT_END:
					return true
				_read_string(buf, true)
				if last_error != "" or not _skip(buf, entry_tag):
					return false
	return _fail("invalid tag %d" % tag)


static func _skip_bytes(buf: StreamPeerBuffer, count: int) -> bool:
	if not _need(buf, count):
		return false
	buf.seek(buf.get_position() + count)
	return true


static func _need(buf: StreamPeerBuffer, count: int) -> bool:
	if buf.get_available_bytes() < count:
		return _fail("unexpected end of data")
	return true


static func _expect(tag: int, want: int, kind: String) -> bool:
	if tag != want:
		return _fail("type mismatch: tag %d cannot be assigned to %s" % [tag, kind])
	return true


# ------------------------------------------------------------------ json

## Returns the JSON encoding of a generated message, or "" on error. Bytes are
## Base64, timestamps RFC 3339 (UTC), enums strings. Nil objects and empty
## arrays and maps are omitted.
static func to_json(object: Object) -> String:
	last_error = ""
	if object == null:
		last_error = "null value cannot be encoded"
		return ""
	var value = _to_json_value(["object", object.get_script()], object)
	if last_error != "":
		return ""
	return JSON.stringify(value)


## Decodes JSON text into a new instance of cls, a generated message class.
## Returns null on error. Unknown fields are ignored.
static func from_json(text: String, cls: GDScript) -> Object:
	last_error = ""
	var json := JSON.new()
	if json.parse(text) != OK:
		last_error = "invalid json: %s (line %d)" % [json.get_error_message(), json.get_error_line()]
		return null
	var value = _from_json_value(["object", cls], json.data)
	if last_error != "":
		return null
	return value


static func _to_json_value(desc: Variant, value: Variant) -> Variant:
	var kind: String = desc if desc is String else desc[0]
	match kind:
		"bytes":
			return Marshalls.raw_to_base64(value) if not value.is_empty() else ""
		"timestamp":
			return _format_time(value)
		"enum":
			var values: Array = desc[1]
			if value < 0 or value >= values.size():
				_fail("invalid enum value %d" % value)
				return null
			return values[value]
		"array":
			var elements := []
			for element in value:
				elements.append(_to_json_value(desc[1], element))
			return elements
		"map":
			var map := {}
			for key in value:
				if not key is String:
					_fail("map keys must be strings")
					return null
				map[key] = _to_json_value(desc[1], value[key])
			return map
		"object":
			if value == null:
				_fail("null element")
				return null
			var map := {}
			for field in value.call("_disorder_fields"):
				var field_value = value.get(field[0])
				if field_value == null:
					continue
				var field_desc = field[1]
				if field_desc is Array and (field_desc[0] == "array" or field_desc[0] == "map") and field_value.is_empty():
					continue
				map[field[0]] = _to_json_value(field_desc, field_value)
			return map
	return value # bool, int, long, float, double, string


static func _from_json_value(desc: Variant, value: Variant) -> Variant:
	var kind: String = desc if desc is String else desc[0]
	match kind:
		"bool":
			if value is bool:
				return value
		"int", "long":
			if value is float or value is int:
				return int(value)
		"float", "double":
			if value is float or value is int:
				return float(value)
		"string":
			if value is String:
				return value
		"bytes":
			if value is String:
				return Marshalls.base64_to_raw(value) if value != "" else PackedByteArray()
		"timestamp":
			if value is String:
				return _parse_time(value)
		"enum":
			if value is String:
				var index: int = (desc[1] as Array).find(value)
				if index >= 0:
					return index
				_fail("invalid enum value \"%s\"" % value)
				return null
		"array":
			if value is Array:
				var elements := []
				for element in value:
					elements.append(_from_json_value(desc[1], element))
					if last_error != "":
						return null
				return elements
		"map":
			if value is Dictionary:
				var map := {}
				for key in value:
					map[key] = _from_json_value(desc[1], value[key])
					if last_error != "":
						return null
				return map
		"object":
			if value is Dictionary:
				return _object_from_json(desc[1], value)
	if last_error == "":
		_fail("type mismatch: cannot assign json %s to %s" % [type_string(typeof(value)), kind])
	return null


static func _object_from_json(cls: GDScript, data: Dictionary) -> Object:
	var object: Object = cls.new()
	for field in object.call("_disorder_fields"):
		if not data.has(field[0]) or data[field[0]] == null:
			continue
		var value = _from_json_value(field[1], data[field[0]])
		if last_error != "":
			return null
		_assign(object, field[0], field[1], value)
	return object


static func _format_time(ms: int) -> String:
	var seconds := floori(ms / 1000.0)
	var date := Time.get_datetime_dict_from_unix_time(seconds)
	return "%04d-%02d-%02dT%02d:%02d:%02d.%03dZ" % [
		date.year, date.month, date.day, date.hour, date.minute, date.second, ms - seconds * 1000]


static var _time_pattern: RegEx


static func _parse_time(text: String) -> Variant:
	if _time_pattern == null:
		_time_pattern = RegEx.create_from_string("^(\\d{4})-(\\d{2})-(\\d{2})[Tt](\\d{2}):(\\d{2}):(\\d{2})(?:\\.(\\d+))?([Zz]|[+-]\\d{2}:\\d{2})$")
	var m := _time_pattern.search(text)
	if m == null:
		_fail("invalid timestamp \"%s\", expect RFC 3339" % text)
		return null
	var seconds := Time.get_unix_time_from_datetime_dict({
		"year": m.get_string(1).to_int(), "month": m.get_string(2).to_int(), "day": m.get_string(3).to_int(),
		"hour": m.get_string(4).to_int(), "minute": m.get_string(5).to_int(), "second": m.get_string(6).to_int(),
	})
	var ms := 0
	if m.get_string(7) != "":
		ms = (m.get_string(7) + "00").substr(0, 3).to_int()
	var zone := m.get_string(8)
	if zone.length() == 6:
		var offset := zone.substr(1, 2).to_int() * 3600 + zone.substr(4, 2).to_int() * 60
		seconds -= offset if zone[0] == "+" else -offset
	return seconds * 1000 + ms
